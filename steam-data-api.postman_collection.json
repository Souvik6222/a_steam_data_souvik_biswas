{
  "info": {
    "name": "Steam Data API",
    "description": "Complete Postman collection for the Steam Data REST API.\n\nSet the `baseUrl` collection variable to your server URL before use.\nDefault: http://localhost:5000\n\nAuthentication:\n1. POST /api/v1/auth/register  → creates account\n2. POST /api/v1/auth/login     → returns token\n3. Copy token into the `token` collection variable\n4. All protected requests will use Bearer {{token}} automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string",
      "description": "Base URL of the Steam Data API server"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT bearer token — set after a successful login"
    },
    {
      "key": "appid",
      "value": "3057270",
      "type": "string",
      "description": "Default Steam appid used in parameterised requests"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "🎮 Games",
      "description": "Core game CRUD — /api/games",
      "item": [
        {
          "name": "List Games",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/games?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "games"],
              "query": [
                { "key": "page",  "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "genre", "value": "",  "disabled": true },
                { "key": "rating","value": "",  "disabled": true }
              ]
            },
            "description": "Fetch all non-deleted games. Supports ?page, ?limit, ?genre, ?rating, ?sort."
          }
        },
        {
          "name": "Get Game by appid",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/games/{{appid}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "games", "{{appid}}"]
            }
          }
        },
        {
          "name": "Create Game",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/games",
              "host": ["{{baseUrl}}"],
              "path": ["api", "games"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"appid\": 9999999,\n  \"title\": \"Test Game\",\n  \"description\": \"A test game created via the API.\",\n  \"developer\": \"Test Studio\",\n  \"publisher\": \"Test Publisher\",\n  \"release_date\": \"2024-01-15\",\n  \"genres\": [\"Action\", \"Indie\"],\n  \"tags\": [\"Single-player\"],\n  \"price\": {\n    \"original\": 9.99,\n    \"discounted\": 7.99,\n    \"discount_percent\": 20,\n    \"isFree\": false\n  },\n  \"rating\": 8.5,\n  \"downloads\": 12000,\n  \"isSingleplayer\": true,\n  \"isIndieGame\": true\n}"
            },
            "description": "Create a new game. Required: title, appid. rating must be 0–10, price ≥ 0, release_date must be ISO 8601."
          }
        },
        {
          "name": "Update Game (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/games/{{appid}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "games", "{{appid}}"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"rating\": 9.0,\n  \"downloads\": 50000\n}"
            }
          }
        },
        {
          "name": "Replace Game (PUT)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/games/{{appid}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "games", "{{appid}}"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"title\": \"Replaced Game Title\",\n  \"developer\": \"New Studio\",\n  \"publisher\": \"New Publisher\",\n  \"genres\": [\"RPG\"],\n  \"rating\": 7.5\n}"
            }
          }
        },
        {
          "name": "Delete Game",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/games/{{appid}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "games", "{{appid}}"]
            }
          }
        },
        {
          "name": "Archive Game (Soft Delete)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/games/{{appid}}/archive",
              "host": ["{{baseUrl}}"],
              "path": ["api", "games", "{{appid}}", "archive"]
            }
          }
        },
        {
          "name": "Restore Game",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/games/{{appid}}/restore",
              "host": ["{{baseUrl}}"],
              "path": ["api", "games", "{{appid}}", "restore"]
            }
          }
        },
        {
          "name": "Game Exists",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/games/{{appid}}/exists",
              "host": ["{{baseUrl}}"],
              "path": ["api", "games", "{{appid}}", "exists"]
            }
          }
        },
        {
          "name": "Game Summary",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/games/{{appid}}/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "games", "{{appid}}", "summary"]
            }
          }
        },
        {
          "name": "HEAD /api/games",
          "request": {
            "method": "HEAD",
            "url": {
              "raw": "{{baseUrl}}/api/games",
              "host": ["{{baseUrl}}"],
              "path": ["api", "games"]
            },
            "description": "Returns Content-Type and Allow headers. No body."
          }
        },
        {
          "name": "OPTIONS /api/games",
          "request": {
            "method": "OPTIONS",
            "url": {
              "raw": "{{baseUrl}}/api/games",
              "host": ["{{baseUrl}}"],
              "path": ["api", "games"]
            }
          }
        }
      ]
    },
    {
      "name": "📖 Reviews",
      "description": "Game review sub-resource — /api/games/:appid/reviews",
      "item": [
        {
          "name": "Get Reviews",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/games/{{appid}}/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["api", "games", "{{appid}}", "reviews"]
            }
          }
        },
        {
          "name": "Add Review",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/games/{{appid}}/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["api", "games", "{{appid}}", "reviews"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"user\": \"SteamUser123\",\n  \"comment\": \"An absolutely fantastic game. Highly recommended!\",\n  \"score\": 9\n}"
            }
          }
        },
        {
          "name": "Update Review",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/games/{{appid}}/reviews/:reviewId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "games", "{{appid}}", "reviews", ":reviewId"],
              "variable": [{ "key": "reviewId", "value": "" }]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"score\": 8,\n  \"comment\": \"Updated review after more playtime.\"\n}"
            }
          }
        },
        {
          "name": "Delete Review",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/games/{{appid}}/reviews/:reviewId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "games", "{{appid}}", "reviews", ":reviewId"],
              "variable": [{ "key": "reviewId", "value": "" }]
            }
          }
        }
      ]
    },
    {
      "name": "🔍 Sub-Resources",
      "description": "Per-game sub-resources — screenshots, trailers, DLC, achievements, etc.",
      "item": [
        {
          "name": "Screenshots",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/games/{{appid}}/screenshots", "host": ["{{baseUrl}}"], "path": ["api","games","{{appid}}","screenshots"] } }
        },
        {
          "name": "Trailers",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/games/{{appid}}/trailers", "host": ["{{baseUrl}}"], "path": ["api","games","{{appid}}","trailers"] } }
        },
        {
          "name": "DLC",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/games/{{appid}}/dlc", "host": ["{{baseUrl}}"], "path": ["api","games","{{appid}}","dlc"] } }
        },
        {
          "name": "Achievements",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/games/{{appid}}/achievements", "host": ["{{baseUrl}}"], "path": ["api","games","{{appid}}","achievements"] } }
        },
        {
          "name": "Leaderboard",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/games/{{appid}}/leaderboard", "host": ["{{baseUrl}}"], "path": ["api","games","{{appid}}","leaderboard"] } }
        },
        {
          "name": "Updates",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/games/{{appid}}/updates", "host": ["{{baseUrl}}"], "path": ["api","games","{{appid}}","updates"] } }
        },
        {
          "name": "News",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/games/{{appid}}/news", "host": ["{{baseUrl}}"], "path": ["api","games","{{appid}}","news"] } }
        },
        {
          "name": "System Requirements",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/games/{{appid}}/system-requirements", "host": ["{{baseUrl}}"], "path": ["api","games","{{appid}}","system-requirements"] } }
        }
      ]
    },
    {
      "name": "🏷️ Filters & Sort",
      "description": "Static filter and sort routes — registered BEFORE /:appid",
      "item": [
        { "name": "Free to Play",        "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/games/filter/free-to-play",       "host": ["{{baseUrl}}"], "path": ["api","games","filter","free-to-play"] } } },
        { "name": "Paid Games",           "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/games/filter/paid",               "host": ["{{baseUrl}}"], "path": ["api","games","filter","paid"] } } },
        { "name": "Discounted",           "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/games/filter/discounted",          "host": ["{{baseUrl}}"], "path": ["api","games","filter","discounted"] } } },
        { "name": "Early Access",         "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/games/filter/early-access",       "host": ["{{baseUrl}}"], "path": ["api","games","filter","early-access"] } } },
        { "name": "Multiplayer",          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/games/filter/multiplayer",        "host": ["{{baseUrl}}"], "path": ["api","games","filter","multiplayer"] } } },
        { "name": "Singleplayer",         "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/games/filter/singleplayer",       "host": ["{{baseUrl}}"], "path": ["api","games","filter","singleplayer"] } } },
        { "name": "Co-op",                "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/games/filter/coop",               "host": ["{{baseUrl}}"], "path": ["api","games","filter","coop"] } } },
        { "name": "Horror",               "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/games/filter/horror",             "host": ["{{baseUrl}}"], "path": ["api","games","filter","horror"] } } },
        { "name": "Indie",                "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/games/filter/indie",              "host": ["{{baseUrl}}"], "path": ["api","games","filter","indie"] } } },
        { "name": "Top Rated",            "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/games/filter/top-rated",          "host": ["{{baseUrl}}"], "path": ["api","games","filter","top-rated"] } } },
        { "name": "Sort by Rating",       "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/games/sort/rating-desc",          "host": ["{{baseUrl}}"], "path": ["api","games","sort","rating-desc"] } } },
        { "name": "Sort by Downloads",    "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/games/sort/downloads-desc",       "host": ["{{baseUrl}}"], "path": ["api","games","sort","downloads-desc"] } } },
        { "name": "Sort by Price",        "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/games/sort/price-desc",           "host": ["{{baseUrl}}"], "path": ["api","games","sort","price-desc"] } } },
        { "name": "Sort by Release Date", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/games/sort/releaseDate-desc",     "host": ["{{baseUrl}}"], "path": ["api","games","sort","releaseDate-desc"] } } }
      ]
    },
    {
      "name": "🔎 Search",
      "description": "Full-text search — /api/v1/search",
      "item": [
        {
          "name": "Search Games",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/search?q=action&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "search"],
              "query": [
                { "key": "q",     "value": "action" },
                { "key": "page",  "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "🔐 Auth",
      "description": "Authentication — /api/v1/auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"name\": \"Souvik Biswas\",\n  \"email\": \"souvik@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "description": "Requires valid email and password ≥ 6 characters. Returns JWT token in data.token."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"souvik@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "description": "Returns data.token. Copy into the `token` collection variable."
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "profile"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "profile"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"name\": \"Souvik Updated\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","forgot-password"] },
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"email\": \"souvik@example.com\"\n}" }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","reset-password"] },
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"token\": \"<reset-token-from-forgot-password>\",\n  \"newPassword\": \"newsecret456\"\n}" }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/change-password", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","change-password"] },
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"oldPassword\": \"secret123\",\n  \"newPassword\": \"newsecret456\"\n}" }
          }
        }
      ]
    },
    {
      "name": "🔑 JWT",
      "description": "JWT token management — /api/v1/jwt  (all require Authorization: Bearer {{token}})",
      "item": [
        { "name": "Profile",           "request": { "method": "GET",    "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/v1/jwt/profile",          "host": ["{{baseUrl}}"], "path": ["api","v1","jwt","profile"] } } },
        { "name": "Dashboard",         "request": { "method": "GET",    "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/v1/jwt/dashboard",         "host": ["{{baseUrl}}"], "path": ["api","v1","jwt","dashboard"] } } },
        { "name": "Private Games",     "request": { "method": "GET",    "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/v1/jwt/private-games",    "host": ["{{baseUrl}}"], "path": ["api","v1","jwt","private-games"] } } },
        { "name": "Private Analytics", "request": { "method": "GET",    "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/v1/jwt/private-analytics", "host": ["{{baseUrl}}"], "path": ["api","v1","jwt","private-analytics"] } } },
        {
          "name": "Verify Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/jwt/verify-token", "host": ["{{baseUrl}}"], "path": ["api","v1","jwt","verify-token"] },
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"token\": \"{{token}}\"\n}" }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/jwt/refresh-token", "host": ["{{baseUrl}}"], "path": ["api","v1","jwt","refresh-token"] },
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"token\": \"{{token}}\"\n}" }
          }
        },
        { "name": "Revoke Token",      "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/v1/jwt/revoke-token",    "host": ["{{baseUrl}}"], "path": ["api","v1","jwt","revoke-token"] } } }
      ]
    },
    {
      "name": "📈 Analytics",
      "description": "Aggregation analytics — /api/v1/analytics",
      "item": [
        { "name": "Top Rated",             "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/v1/analytics/top-rated",             "host": ["{{baseUrl}}"], "path": ["api","v1","analytics","top-rated"] } } },
        { "name": "Most Downloaded",       "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/v1/analytics/most-downloaded",       "host": ["{{baseUrl}}"], "path": ["api","v1","analytics","most-downloaded"] } } },
        { "name": "Revenue",               "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/v1/analytics/revenue",               "host": ["{{baseUrl}}"], "path": ["api","v1","analytics","revenue"] } } },
        { "name": "Platform Distribution", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/v1/analytics/platform-distribution", "host": ["{{baseUrl}}"], "path": ["api","v1","analytics","platform-distribution"] } } },
        { "name": "Genre Distribution",    "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/v1/analytics/genre-distribution",    "host": ["{{baseUrl}}"], "path": ["api","v1","analytics","genre-distribution"] } } },
        { "name": "Trending",              "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/v1/analytics/trending",              "host": ["{{baseUrl}}"], "path": ["api","v1","analytics","trending"] } } },
        { "name": "Release Trends",        "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/v1/analytics/release-trends",        "host": ["{{baseUrl}}"], "path": ["api","v1","analytics","release-trends"] } } },
